# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# Nunca envie o .env.local para o GitHub.
# Todas as integrações são opcionais: sem a chave, o site mostra
# dados de reserva (fallback) em vez de quebrar.
# ============================================================

# --- Formulário de contato (EmailJS) — usado no navegador ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- GitHub (repositórios recentes) ---
GITHUB_USERNAME=vGustav1
# Opcional: token só para aumentar o limite de requisições
GITHUB_TOKEN=

# --- Xadrez (Chess.com, API pública) ---
CHESS_USERNAME=

# --- Steam ---
STEAM_API_KEY=
STEAM_ID=

# --- Spotify (refresh token gerado uma vez) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- League of Legends (Riot) ---
RIOT_API_KEY=
RIOT_GAME_NAME=
RIOT_TAG_LINE=
RIOT_REGION=americas
RIOT_PLATFORM=br1
